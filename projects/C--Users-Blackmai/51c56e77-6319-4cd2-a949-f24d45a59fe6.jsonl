))\ninv.append(('高铁-汕头至南昌西-20260622-孙伟成', 425.00, '2026-06-22', '长途交通费'))\ninv.append(('高铁-南昌西至汕头-20260625-蔡劢', 415.00, '2026-06-25', '长途交通费'))\ninv.append(('高铁-南昌西至汕头-20260625-陈建华', 415.00, '2026-06-25', '长途交通费'))\ninv.append(('高铁-南昌西至汕头-20260625-付汝龙', 415.00, '2026-06-25', '长途交通费'))\ninv.append(('高铁-南昌西至汕头-20260625-张慧仪', 415.00, '2026-06-25', '长途交通费'))\ninv.append(('高铁-南昌西至汕头-20260625-孙伟成', 415.00, '2026-06-25', '长途交通费'))\n\n# City transport (4 invoices)\ninv.append(('滴滴-南昌(南昌西站至铂瑞酒店)-20260622-张慧仪', 9.30, '2026-06-22', '市内交通费'))\ninv.append(('滴滴-南昌(南昌西站至铂瑞酒店)-20260622-孙伟成', 9.30, '2026-06-22', '市内交通费'))\ninv.append(('滴滴-南昌(铂瑞酒店至南昌西站)-20260625-张慧仪', 9.60, '2026-06-25', '市内交通费'))\ninv.append(('滴滴-南昌(铂瑞酒店至南昌西站)-20260625-孙伟成', 9.60, '2026-06-25', '市内交通费'))\n\n# Hotel (1 invoice)\ninv.append(('南昌-绿地铂瑞酒店-20260622', 3900.00, '2026-06-22', '住宿费'))\n\n# Write data\ncurrent_row = 3\nfor seq, (name, amount, date, cat) in enumerate(inv, 1):\n    ws.cell(row=current_row, column=1, value=seq).font = normal_font\n    ws.cell(row=current_row, column=1).alignment = center_align\n    ws.cell(row=current_row, column=1).border = thin_border\n\n    ws.cell(row=current_row, column=2, value=name).font = normal_font\n    ws.cell(row=current_row, column=2).alignment = left_align\n    ws.cell(row=current_row, column=2).border = thin_border\n\n    ws.cell(row=current_row, column=3, value=amount).font = normal_font\n    ws.cell(row=current_row, column=3).alignment = right_align\n    ws.cell(row=current_row, column=3).number_format = '#,##0.00'\n    ws.cell(row=current_row, column=3).border = thin_border\n\n    ws.cell(row=current_row, column=4, value=date).font = normal_font\n    ws.cell(row=current_row, column=4).alignment = center_align\n    ws.cell(row=current_row, column=4).border = thin_border\n\n    ws.cell(row=current_row, column=5, value=cat).font = normal_font\n    ws.cell(row=current_row, column=5).alignment = center_align\n    ws.cell(row=current_row, column=5).border = thin_border\n\n    current_row += 1\n\n# Track category boundaries for formulas\ndata_start = 3\nlong_first = data_start\nlong_last = data_start + 7  # 8 invoices\ncity_first = long_last + 1\ncity_last = city_first + 3  # 4 invoices\nhotel_row = city_last + 1\n\n# --- Long distance subtotal ---\nr = current_row\nws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=2)\nws.cell(row=r, column=2, value='长途交通费 小计').font = subtotal_font\nws.cell(row=r, column=2).alignment = right_align\nfor c in [1, 2, 3, 4, 5]:\n    ws.cell(row=r, column=c).border = thin_border\nws.cell(row=r, column=3).font = subtotal_font\nws.cell(row=r, column=3).alignment = right_align\nws.cell(row=r, column=3).number_format = '#,##0.00'\nws.cell(row=r, column=3, value='=SUM(C%d:C%d)' % (long_first, long_last))\nlong_sub = r\ncurrent_row = r + 1\n\n# --- City transport subtotal ---\nr = current_row\nws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=2)\nws.cell(row=r, column=2, value='市内交通费 小计').font = subtotal_font\nws.cell(row=r, column=2).alignment = right_align\nfor c in [1, 2, 3, 4, 5]:\n    ws.cell(row=r, column=c).border = thin_border\nws.cell(row=r, column=3).font = subtotal_font\nws.cell(row=r, column=3).alignment = right_align\nws.cell(row=r, column=3).number_format = '#,##0.00'\nws.cell(row=r, column=3, value='=SUM(C%d:C%d)' % (city_first, city_last))\ncity_sub = r\ncurrent_row = r + 1\n\n# --- Hotel subtotal ---\nr = current_row\nws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=2)\nws.cell(row=r, column=2, value='住宿费 小计').font = subtotal_font\nws.cell(row=r, column=2).alignment = right_align\nfor c in [1, 2, 3, 4, 5]:\n    ws.cell(row=r, column=c).border = thin_border\nws.cell(row=r, column=3).font = subtotal_font\nws.cell(row=r, column=3).alignment = right_align\nws.cell(row=r, column=3).number_format = '#,##0.00'\nws.cell(row=r, column=3, value='=C%d' % hotel_row)\nhotel_sub = r\ncurrent_row = r + 1\n\n# --- Grand total ---\nr = current_row\nws.merge_c